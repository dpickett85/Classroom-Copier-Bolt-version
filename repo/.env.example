# Classroom Copier — server environment.
#
# Copy to `.env` and fill in. Every name below is one that `server/src/config.ts`
# actually reads; nothing here is aspirational, and nothing config.ts reads is
# missing. PLACEHOLDERS ONLY — never commit a real secret to this file.
#
# `npm run dev` and `npm start` both load `.env` via node's
# --env-file-if-exists, so no dotenv package is involved.

# ------------------------------------------------------------------
# Required in every environment
# ------------------------------------------------------------------

# Signs the session JWT. Boot FAILS FAST in a production-like NODE_ENV if this
# is missing, rather than silently falling back to a dev default.
#   openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-string

# Where Prisma writes. SQLite for local dev and tests; a Render Postgres
# connection string in production. Must agree with DATABASE_PROVIDER below.
DATABASE_URL=file:./dev.db

# sqlite | postgresql. Selects the datasource block that
# `scripts/prisma-datasource.mjs` generates into schema.prisma. Changing this
# without changing DATABASE_URL is the mistake it exists to make visible.
DATABASE_PROVIDER=sqlite

# development | test | production
NODE_ENV=development

PORT=4000

# Comma-separated allow-list for CORS. In production this is the frontend's
# Render origin; the API and the frontend are separate services, so the session
# cookie is SameSite=None; Secure and the origin must match exactly.
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------
# Google — required when GOOGLE_PROVIDER_MODE=google
# ------------------------------------------------------------------

# mock | google. Boot FAILS FAST on `mock` (or unset) under a production-like
# NODE_ENV: the mock account routes are not even registered in google mode, so
# there is no code path in production that mints a session without Google.
GOOGLE_PROVIDER_MODE=mock

# From the Google Cloud console's OAuth 2.0 Client ID (Web application).
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Must match an Authorised redirect URI on that same client, character for
# character — including the scheme and any trailing path.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/callback

# AES-256-GCM key for the stored Google access tokens. DELIBERATELY NOT
# SESSION_SECRET: a compromise of the JWT-signing key must not also expose every
# teacher's Google token. Must decode to exactly 32 bytes of base64 — boot
# refuses anything else rather than encrypting under a short key.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-me-with-32-bytes-of-base64

# Where the OAuth callback redirects the browser back to. This is a BOOT-TIME
# CONSTANT and is never taken from the request — that is what closes the open
# redirect. Falls back to the first entry in CORS_ORIGINS when unset.
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Tuning — all optional, all defaulted in config.ts
# ------------------------------------------------------------------

# A transfer whose Google token has less than this left never starts; the
# teacher is asked to reconnect first. Default 10 minutes.
GOOGLE_TOKEN_MIN_REMAINING_MS=600000

# How long a job paused for re-auth is exempt from the reconciler's staleness
# sweep. Too short and the reconciler terminates the job while the teacher is
# still on Google's consent screen. Default 30 minutes.
GOOGLE_REAUTH_GRACE_MS=1800000

# How long without a heartbeat before an executor is presumed dead.
JOB_STALE_AFTER_MS=120000

# How often the reconciler sweeps. It runs on an interval, not only at boot.
RECONCILER_INTERVAL_MS=30000

# How long a pre-flight scan stays fresh enough to start a transfer from.
SCAN_TTL_MS=600000

SESSION_TTL_MS=86400000

# Reserved. No payment provider is wired; this only gates a UI affordance.
FEATURE_MONETIZATION_ENABLED=false

# Re-seed the mock fixture world on boot. Idempotent.
SEED_ON_BOOT=true

# Delete rows a previous TRANSFER created inside seeded courses, on boot.
PRUNE_GENERATED_ON_BOOT=false

# ------------------------------------------------------------------
# Harness knobs — for driving the deployed app by hand. NEVER fixture data.
# ------------------------------------------------------------------

# Simulates a cold start so the 2s overlay and the 60s ceiling can be seen.
# COLD_START_SIMULATE_DELAY_MS=0

# F12's slow mode as an env var. Normally a run-scoped provider option; as
# seeded data it would mean the throughput budget measured its own harness.
# MOCK_PROVIDER_DELAY_MS=0
