{
  "name": "@classroom-copier/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:budget:a11y": "vitest run a11y",
    "test:budget:coldstart": "vitest run src/lib/api-client.coldstart.test.ts",
    "test:budget:no-tailwind": "vitest run src/test/quality/no-tailwind.quality.test.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@classroom-copier/shared": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.10.3",
    "jsdom": "^26.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
